model User {
  id              String           @id
  name            String
  email           String           @unique
  emailVerified   Boolean          @default(false)
  image           String?
  role            String           @default("CUSTOMER")
  status          String           @default("ACTIVE")
  phone           String?
  address         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accounts        Account[]
  orders          Order[]
  providerProfile ProviderProfile?
  review          Review[]
  sessions        Session[]
  @@map("user")
}
