model Review {
  id         String   @id @default(cuid())
  customerId String
  mealId     String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String?
  meal       Meal     @relation(fields: [mealId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([customerId, mealId])
  @@map("review")
}
