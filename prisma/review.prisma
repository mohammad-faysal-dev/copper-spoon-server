model Review {
    id         String   @id @default(cuid())
    customerId String
    mealId     String
    rating     Int
    comment    String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    user   User?   @relation(fields: [userId], references: [id])
    userId String?
    meal   Meal    @relation(fields: [mealId], references: [id])

    @@index([customerId, mealId])
}
